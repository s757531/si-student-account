# 🎓 SI STUDENT ACCOUNT - পরিবেশ কনফিগারেশন
# এই ফাইলটি .env.example হিসেবে রাখুন
# .env নাম দিয়ে সংরক্ষণ করুন এবং মান পূরণ করুন

# ========================================
# 🤖 TELEGRAM BOT সেটিংস
# ========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ========================================
# 🌐 FLASK ওয়েব সার্ভার
# ========================================
FLASK_APP=admin_panel/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SECRET_KEY=your_secret_key_change_this

# ========================================
# 📊 ডাটাবেস
# ========================================
DATABASE_PATH=data/database.db
DATABASE_URL=sqlite:///data/database.db

# ========================================
# 🔐 এডমিন প্যানেল
# ========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@siaccount.edu

# ========================================
# 📧 ইমেইল সেটিংস (ভবিষ্যতে)
# ========================================
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ========================================
# 💰 পেমেন্ট সেটিংস (কাস্টম)
# ========================================
PAYMENT_CURRENCY=USD
MIN_CREDIT_LOAD=5
MAX_CREDIT_LOAD=1000

# ========================================
# 🌍 দেশ সেটিংস
# ========================================
SUPPORTED_COUNTRIES=USA,Bangladesh
TIMEZONE=UTC

# ========================================
# 📝 লগিং
# ========================================
LOG_LEVEL=INFO
LOG_FILE=data/logs.txt